# ============ 名片宝 · 环境变量 ============
# 复制本文件为 .env 后填写。未填写的项会自动使用免费兜底。

# ===== 账号系统 =====
# 首次启动时若用户表为空，会自动创建下面这个管理员账号（之后可在「账户管理」里改）。
# 注意：本文件会随公开仓库一同发布，请勿在此填写真实密码！
#       真实密码只写进 .env（.env 已在 .gitignore 中排除，不会提交）。
DEFAULT_ADMIN_USER=admin
# 请务必替换为你自己的强密码；不设置时程序会回退到内置默认值，存在被猜测的风险。
DEFAULT_ADMIN_PASS=CHANGE_ME_BEFORE_DEPLOY
# 登录会话有效期（秒），默认 14 天
SESSION_TTL=1209600

# ===== 调研队列（并发限流 + 每日配额）=====
# 同时执行的调研任务数（默认 2）。调小更省 API，调大更快但更耗额度。
# 注意：修改后需重启容器生效（也可在「API 设置」页配置，重启后生效）。
RESEARCH_CONCURRENCY=2
# 每个账号每天最多发起的调研次数（默认 10；填 0 表示不限制）。
DAILY_RESEARCH_QUOTA=10

# ===== DeepSeek（调研文本生成，必填）=====
# 也可登录后在「API 设置」/「账户管理」页面里配置（即时生效，无需改此文件）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== 视觉模型（名片 OCR，选填；不填则本地 Tesseract 兜底）=====
# VISION_PROVIDER 可选：openai(默认) / qwen / kimi / ollama
# 免费优先推荐：
#   qwen   → 阿里云百炼 通义千问 VL（国内稳定、中文名片识别强、有免费额度）
#            VISION_API_KEY=你的DashScope密钥；下面 BASE_URL/MODEL 会自动填好
#   kimi   → Moonshot Kimi 视觉（有免费额度）
#            VISION_API_KEY=你的Moonshot密钥
#   ollama → 本地 Ollama + Llama3.2-Vision（零成本、可离线、隐私；需另跑 ollama 容器）
# 若不填 VISION_API_KEY，则自动回退本地 Tesseract（弱识别，关键字段需手填）。
VISION_PROVIDER=openai
VISION_API_KEY=
# 仅当使用非预设厂商时才需要手动改下面两行；预设厂商会按 VISION_PROVIDER 自动设置
VISION_BASE_URL=
VISION_MODEL=

# ===== 搜索源（选填；决定报告是否带图片/视频墙）=====
# SEARCH_PROVIDER 可选：ddg(默认,免Key) / serper / brave / tavily
# 免费优先推荐：
#   ddg    → DuckDuckGo 免 Key 兜底（开箱即用，仅文本，无媒体墙）
#   serper → Serper（注册送 2500 次，返回图片+视频，媒体墙效果最佳）→ 填 SERPER_API_KEY
#   brave  → Brave Search（每月 2000 次免费，独立索引）→ 填 BRAVE_API_KEY
#   tavily → Tavily（每月 1000 次免费，AI 友好）→ 填 TAVILY_API_KEY
SEARCH_PROVIDER=ddg
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
